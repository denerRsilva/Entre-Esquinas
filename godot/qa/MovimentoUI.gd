extends "res://qa/CozinhaUI.gd"
func key(code: Key, pressed: bool):
	var event:=InputEventKey.new()
	event.keycode=code;event.pressed=pressed;root.push_input(event);g.tick(0)
func position_player() -> Vector2:
	var p=JSON.parse_string(js("JSON.stringify(R.position(state.player))"))
	return Vector2(p.x,p.y)
func run():
	root.size=Vector2i(960,700)
	g=load("res://mundo/Restaurante.tscn").instantiate()
	root.add_child(g);g.set_process(false)
	await layout()
	check(await button("Começar na taverna"),"Iniciar partida")
	check(Engine.max_fps==60,"Limite de renderização em 60 FPS")
	js("Object.assign(state.player,{x:5,y:10,settled:null,motion:null,goal:null})")
	g.tick(0);await layout()
	key(KEY_A,true)
	for i in 45:g.tick(1.0/60.0)
	var wall:=position_player()
	check(absf(wall.x-4.7)<0.001,"Parar no limite físico da parede")
	var sprite: AnimatedSprite2D=g.palco.pool.cozinheira[0]
	check(not sprite.is_playing(),"Não caminhar parado contra a parede")
	key(KEY_S,true)
	for i in 30:g.tick(1.0/60.0)
	check(position_player().y>wall.y+1 and absf(position_player().x-wall.x)<0.001,"Deslizar ao longo da parede com diagonal")
	key(KEY_A,false);key(KEY_S,false)
	var stopped:=position_player()
	g.tick(.2)
	check(position_player().distance_to(stopped)<0.00001,"Soltar teclas para imediatamente sem completar célula")
	key(KEY_D,true)
	var previous:=position_player()
	for i in 3:
		g._process(1.0/61.0)
		check(position_player().x>previous.x,"Atualizar movimento em cada quadro sem salto de temporizador")
		previous=position_player()
	check(position_player().x>stopped.x,"Afastar da parede no primeiro quadro")
	check(sprite.is_playing() and sprite.animation==&"direita","Animação acompanha o movimento livre")
	key(KEY_D,false)
	check(js("R.valid(state)")=="true","Estado salvável após movimento perto da parede")
	var saved_position:=position_player()
	var copy=js("JSON.stringify(state)")
	js("state=R.migrateSave("+copy+")")
	g.tick(.2)
	check(position_player().distance_to(saved_position)<0.00001,"Posição fracionária mantida ao carregar")
	var loaded:=position_player();g.tick(.2)
	check(position_player().distance_to(loaded)<0.00001,"Tecla pressionada não fica presa no salvamento")
	key(KEY_UP,true);g.tick(.02)
	g._notification(Node.NOTIFICATION_APPLICATION_FOCUS_OUT)
	var blurred:=position_player()
	g._process(.5)
	g._notification(Node.NOTIFICATION_APPLICATION_FOCUS_IN)
	g._process(.05)
	check(position_player().distance_to(blurred)<0.00001,"Perder foco libera o movimento")
	js("R.setPlayerInput(state,0,0);Object.assign(state.player,{x:5,y:14,settled:null,motion:null,goal:null})")
	g.tick(0)
	key(KEY_S,true)
	for i in 30:g.tick(1.0/60.0)
	key(KEY_D,true)
	for i in 15:g.tick(1.0/60.0)
	check(sprite.animation==&"direita","Animação segue o eixo livre ao deslizar na parede inferior")
	key(KEY_S,false);key(KEY_D,false)
	for diagonal in [[KEY_W,KEY_A,"cima"],[KEY_W,KEY_D,"cima"],[KEY_S,KEY_A,"baixo"],[KEY_S,KEY_D,"baixo"]]:
		js("releaseKeyboard();state=R.fresh(true);Object.assign(state.player,{x:9,y:7})")
		g.tick(0)
		key(diagonal[0],true);key(diagonal[1],true)
		var stable:=true
		for i in 60:
			g.tick([1.0/144.0,1.0/61.0,1.0/30.0,1.0/60.0][i%4])
			if sprite.animation!=StringName(diagonal[2]):stable=false
		check(stable,"Diagonal mantém "+diagonal[2]+" durante todos os quadros: "+str(diagonal[1]))
		key(diagonal[0],false);key(diagonal[1],false)
		g.tick(.1)
		check(not sprite.is_playing(),"Parada interrompe caminhada diagonal")
	print("FALHAS: ",failures)
	g.queue_free();await process_frame;quit(1 if failures else 0)
