extends "res://qa/CozinhaUI.gd"
func run():
	root.size=Vector2i(960,700)
	g=load("res://mundo/Restaurante.tscn").instantiate()
	root.add_child(g);g.set_process(false)
	await layout()
	check(await button("Começar vazio") and js("state.objects.length")=="0","Partida vazia sem móveis gratuitos")
	check(js("R.valid(state)")=="true","Partida vazia válida")
	# Furnished fixture isolates furniture operations from buying the initial setup.
	js("state=R.furnishedTest();selectedObject=null;refresh()")
	g.tick(0);await layout()
	check(await button("Gestão"),"Abrir Gestão")
	await layout()
	check(await button("Modo construção"),"Construção pelo controle nativo")
	var original_time := js("state.time")
	g.tick(1)
	check(js("state.time")==original_time,"Construção congela simulação")
	var object_id := js("state.objects.find(o=>o.type==='chair').id")
	var original_cash := js("state.cash")
	var original_qty := js("state.objects.length")
	var point = JSON.parse_string(js("(()=>{const o=state.objects.find(o=>o.type==='chair');return JSON.stringify(screenPoint(o.x*40+20,o.y*40+20))})()"))
	click_at(Vector2(point.x,point.y));await layout()
	check(js("String(building?.moving)")==object_id,"Selecionar cadeira no mapa")
	check(await button("Girar ↻"),"Girar pelo controle nativo")
	var target = JSON.parse_string(js("(()=>{for(let y=1;y<9;y++)for(let x=1;x<13;x++)if(!previewError({...building,room:'restaurant',x,y}))return JSON.stringify({x,y});return 'null'})()"))
	check(target is Dictionary,"Existe posição válida para cadeira girada")
	if target is Dictionary:
		point=JSON.parse_string(js("JSON.stringify(screenPoint("+str(target.x*40+20)+","+str(target.y*40+20)+"))"))
		click_at(Vector2(point.x,point.y));await layout()
		check(await button("Confirmar posição"),"Confirmar mudança pelo mouse")
		check(js("state.cash")==original_cash and js("state.objects.length")==original_qty,"Mover conserva caixa e quantidade")
		check(js("state.objects.some(o=>o.id==="+object_id+"&&o.x==="+str(target.x)+"&&o.y==="+str(target.y)+")")=="true","Mesmo móvel chegou ao destino")
	await layout()
	check(await button("Construção"),"Abrir catálogo de construção")
	await layout()
	check(await button("Voltar ao jogo") and not g.frame_data.construction,"Voltar ao jogo após reforma")
	check(js("R.valid(state)")=="true","Estado válido após reforma")
	print("FALHAS: ",failures)
	g.queue_free();await process_frame
	quit(1 if failures else 0)
