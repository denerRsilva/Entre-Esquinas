extends "res://qa/CozinhaUI.gd"
func run():
	root.size=Vector2i(960,700)
	g=load("res://mundo/Restaurante.tscn").instantiate();root.add_child(g);g.set_process(false)
	await layout()
	check(await button("Começar mobiliado (teste)"),"Início pelo mouse")
	await layout()
	check(g.hud.slots.hotbar[0].visible,"Barra permanente visível")
	var buttons=g.hud.slots.hotbar[1].find_children("*","Button",true,false)
	check(buttons.size()==5,"Exatamente cinco slots")
	check(not await button("Inventário"),"Botão de mochila removido")
	check(await button("3 • 30"),"Selecionar terceiro slot pelo mouse")
	check(js("state.selectedSlot===2")=="true","Seleção do mouse aplicada")
	var e:=InputEventKey.new();e.keycode=KEY_2;e.pressed=true;root.push_input(e);g.tick(0)
	check(js("state.selectedSlot===1")=="true","Tecla 2 seleciona slot")
	var before=float(js("state.time"));g.tick(1)
	check(float(js("state.time"))>before and g.frame_data.modal=="","Barra não pausa nem abre janela")
	check(js("R.valid(state)&&state.inventory.length===5")=="true","Estado válido com cinco slots")
	check(js("Boolean(R.migrateSave(state))")=="true","Save novo válido")
	print("FALHAS: ",failures)
	g.queue_free();await process_frame;quit(1 if failures else 0)
