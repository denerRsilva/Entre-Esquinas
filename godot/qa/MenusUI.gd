extends "res://qa/CozinhaUI.gd"
## Tests use isolated XDG_DATA_HOME; this script writes and imports save files.
func run():
	root.size=Vector2i(960,700)
	g=load("res://mundo/Restaurante.tscn").instantiate()
	root.add_child(g);g.set_process(false)
	await layout()
	check(await button("Tutorial"),"Abrir tutorial")
	await layout()
	check(await button("Fechar tutorial"),"Recolher tutorial")
	await layout()
	check(await button("Começar na taverna") and g.frame_data.modal=="","Início mobiliado após tutorial")
	await layout()
	check(await button("Gestão"),"Menu Gestão pelo mouse")
	for entry in [["Turnos","shifts"],["Equipe","team"],["Fechamento","finance"],["Clientes","customers"],["Calendário","calendar"],["Reputação","reputation"]]:
		await layout()
		check(await button(entry[0]) and js("dialogTab")==entry[1],"Aba Gestão: "+entry[0])
	await layout()
	check(await button("Modo construção") and g.frame_data.construction,"Entrar em construção")
	await layout()
	check(g.frame_data.ui.get("drawer")!=null,"Catálogo abre automaticamente")
	check(await button("Construção") and g.frame_data.ui.get("drawer")==null,"Recolher catálogo")
	await layout()
	check(await button("Construção") and g.frame_data.ui.get("drawer")!=null,"Reabrir catálogo")
	await layout()
	check(await button("Voltar ao jogo") and not g.frame_data.construction,"Sair da construção")
	await layout()
	check(not g.hud.slots.has("hotbar") and js("state.inventory.length===0")=="true","Sem inventário do jogador")
	await layout()
	check(await button("Opções"),"Abrir Opções")
	for entry in [["Câmera","camera"],["Testes","test"],["Primeiros passos","guide"],["Salvar e carregar","save"]]:
		await layout()
		check(await button(entry[0]) and js("dialogTab")==entry[1],"Aba Opções: "+entry[0])
	await layout()
	var cash := js("state.cash")
	check(await button("Salvar restaurante"),"Salvar pelo mouse")
	js("state.cash=1")
	await layout()
	check(await button("Carregar restaurante") and js("state.cash")==cash,"Carregar pelo mouse restaura o caixa")
	check(g.persist(g.values),"Salvar repetidamente sem falhar")
	var valid_save := js("JSON.stringify(state)")
	var file := FileAccess.open("user://import-test.json",FileAccess.WRITE)
	file.store_string(valid_save);file.close()
	g.import_save("user://import-test.json")
	check(g.values.get("entre-restaurante-12")==valid_save,"Importar JSON válido")
	file=FileAccess.open("user://import-test.json",FileAccess.WRITE)
	file.store_string("{invalid");file.close()
	g.import_save("user://import-test.json")
	check(g.active and g.values.get("entre-restaurante-12")==valid_save,"Rejeitar JSON corrompido preservando progresso")
	file=FileAccess.open(g.STORE,FileAccess.WRITE);file.store_string("{invalid");file.close()
	check(not g.read_values().is_empty(),"Recuperar backup se arquivo principal estiver corrompido")
	check(g.persist(g.values),"Gravar novamente após recuperação")
	file=FileAccess.open(g.STORE,FileAccess.WRITE);file.store_string("{invalid");file.close()
	check(not g.read_values().is_empty(),"Backup continua recuperável após gravação")
	print("FALHAS: ",failures)
	g.queue_free();await process_frame
	quit(1 if failures else 0)
