extends "res://qa/MaosUI.gd"
func run():
 root.size=Vector2i(960,700)
 g=load("res://mundo/Restaurante.tscn").instantiate();root.add_child(g);g.set_process(false)
 await layout();await button("Começar na taverna")
 check(js("state.singleRoom&&state.workers.length===1&&state.workers[0].x<14")=="true","Garçom no salão, sem logística")
 js("enterConstruction();renderDialog()");g.tick(0);await layout()
 var catalog=JSON.stringify(g.frame_data.ui.drawer)
 check(catalog.contains("Computador") and catalog.contains("Caixas de recebimento") and catalog.contains("Prateleira seca") and not catalog.contains("Geladeira do estoque"),"Equipamentos opcionais no catálogo")
 js("exitConstruction();R.place(state,'computer',8,10);R.place(state,'receiving',20,12);refresh()")
 g.tick(0);await layout()
 await click_object("computer")
 check(g.frame_data.modal=="management" and js("dialogMode")=="computer","Computador abre na posição instalada")
 await button("Voltar ao jogo")
 check(js("R.purchase(state,'arroz',2)")=="true","Compra com recebimento instalado")
 advance(6);await click_object("receiving")
 check(js("state.player.hand?.item==='arroz'&&state.inv.receiving.arroz===1")=="true","Clique recolhe da caixa instalada")
 check(js("R.valid(state)&&!!R.migrateSave(state)")=="true","Estado salvável com novos móveis")
 print("FALHAS: ",failures)
 g.queue_free();await process_frame;quit(1 if failures else 0)
