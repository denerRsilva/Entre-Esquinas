extends "res://qa/UIBase.gd"
func read(expression: String) -> Variant:return JSON.parse_string(js("JSON.stringify("+expression+")"))
func pointer(phase: String,x: float,y: float,drag: bool = false) -> void:
	g.events.append({"kind":"pointer","phase":phase,"x":x,"y":y,"drag":drag});g.tick(0)
func press(title: String) -> bool:
	await layout()
	var clicked := await button(title)
	await layout()
	return clicked
func run():
	root.size=Vector2i(960,700)
	g=load("res://mundo/Restaurante.tscn").instantiate();root.add_child(g);g.set_process(false)
	await layout()
	check(await press("Começar na taverna"),"Início mobiliado")
	check(await press("Opções"),"Opções de câmera")
	for i in 3:await press("− Afastar")
	check(js("cameraLevel")=="0.7","Zoom mínimo pelos botões")
	check(await press("Restaurar zoom padrão (100%)") and js("cameraLevel")=="1","Restaurar zoom")
	check(await press("Voltar ao jogo"),"Voltar ao mapa")
	js("setCameraLevel(2)")
	check(await press("Gestão") and await press("Modo construção"),"Entrar em construção")
	check(await press("Construção"),"Recolher catálogo para explorar")
	js("camera.x=300;camera.y=300;updateCamera()")
	g.tick(0);await layout()
	var before = read("camera")
	var point = read("screenPoint(13*40+20,10*40+20)")
	pointer("down",point.x,point.y)
	check(js("building===null&&buildPointer!==null")=="true","Clique em célula vazia inicia arrasto")
	pointer("move",point.x-60,point.y+30,true)
	var after = read("camera")
	check(absf(after.x-before.x-60/before.zoom)<1e-8 and absf(after.y-before.y+30/before.zoom)<1e-8,"Arrasto acompanha escala e direção da câmera")
	pointer("up",point.x-60,point.y+30)
	check(js("buildPointer===null")=="true","Soltar botão termina arrasto")
	g.events.append({"kind":"key","key":"d","down":true});g.tick(0)
	var keyboard = read("camera")
	check(absf(keyboard.x-after.x-30)<1e-8,"Teclado desloca câmera na construção")
	g.events.append({"kind":"key","key":"d","down":false});g.tick(0)
	var time := js("state.time");g.tick(2)
	check(js("state.time")==time,"Explorar planta mantém jogo pausado")
	check(await press("Construção") and await press("Voltar ao jogo"),"Sair da construção")
	js("setCameraLevel(1)");g.tick(0)
	check(js("R.valid(state)")=="true","Estado válido após câmera e construção")
	print("FALHAS: ",failures)
	g.queue_free();await process_frame;quit(1 if failures else 0)
