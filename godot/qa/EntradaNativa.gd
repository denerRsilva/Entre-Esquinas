extends "res://qa/UIBase.gd"
func run():
	root.size=Vector2i(960,700)
	g=load("res://mundo/Restaurante.tscn").instantiate()
	root.add_child(g);g.set_process(false)
	await layout()
	js("globalThis.pointerCalls=0;globalThis.oldPointer=canvas.onpointerdown;canvas.onpointerdown=()=>pointerCalls++")
	g.queue_command({"kind":"pointer","phase":"down","x":400,"y":300})
	g.tick(0)
	check(js("pointerCalls")=="0","Boas-vindas bloqueia clique no mapa")
	await button("Começar na taverna")
	g.queue_command({"kind":"pointer","phase":"down","x":400,"y":300})
	g.tick(0)
	check(js("pointerCalls")=="1","Mapa recebe clique fora dos menus")
	js("canvas.onpointerdown=oldPointer")
	js("globalThis.widgetCalls=0;Host.widgets.set('disabled-test',{tag:'button',disabled:true,click(){widgetCalls++}})")
	g.queue_command({"kind":"widget","path":"disabled-test"})
	g.queue_command({"kind":"widget","path":"missing-test"})
	g.tick(0)
	check(js("widgetCalls")=="0","Controles desabilitados e inexistentes são ignorados")
	js("Host.widgets.set('ordered-test',{tag:'button',disabled:false,click(){openDialog('general')}})")
	g.queue_command({"kind":"widget","path":"ordered-test"})
	g.queue_command({"kind":"key","key":"escape","down":true})
	g.tick(0)
	check(g.frame_data.modal=="","Eventos preservam ordem: abrir menu e fechar com Escape")
	js("globalThis.changedValue=null;Host.widgets.set('value-test',{tag:'input',disabled:false,onchange(){changedValue=this.value}})")
	g.queue_command({"kind":"widget","path":"value-test","value":"a'\"\\b"})
	g.tick(0)
	check(js("JSON.stringify(changedValue)")==JSON.stringify("a'\"\\b"),"Valor do controle atravessa a ponte sem interpretação como código")
	print("FALHAS: ",failures)
	g.queue_free();await process_frame
	quit(1 if failures else 0)
