extends "res://qa/UIBase.gd"
func run():
	root.size=Vector2i(960,700)
	g=load("res://mundo/Restaurante.tscn").instantiate();root.add_child(g);g.set_process(false)
	await layout();check(await button("Começar na taverna"),"Iniciar");await layout()
	check(await button("Opções"),"Opções");await layout();check(await button("Salvar e carregar"),"Aba salvar");await layout()
	check(await button("Salvar restaurante"),"Salvar pelo menu")
	await layout()
	check(g.values.has("entre-restaurante-12"),"Save gravado no armazenamento nativo")
	var raw: String = g.values.get("entre-restaurante-12","")
	check(preload("res://simulacao/nativa/Salvamentos.gd").new().load_value(JSON.parse_string(raw))!=null,"Arquivo gravado passa pelo carregador GDScript")
	js("state.cash=42")
	await button("Carregar restaurante");await layout()
	check(js("state.cash")=="1500","Carregar restaura dinheiro e partida")
	js("globalThis.saveSnapshot=()=>{const s=JSON.parse(JSON.stringify(state));delete s.message;return JSON.stringify(s)}")
	var before := js("saveSnapshot()")
	js("Host.values['entre-restaurante-12']='{broken'")
	await button("Carregar restaurante");await layout()
	check(JSON.parse_string(js("saveSnapshot()"))==JSON.parse_string(before),"Arquivo corrompido preserva a partida")
	var bad := FileAccess.open("/tmp/save-invalido-migracao.json",FileAccess.WRITE)
	bad.store_string("{broken");bad.close()
	g.import_save("/tmp/save-invalido-migracao.json");await layout()
	check(JSON.parse_string(js("saveSnapshot()"))==JSON.parse_string(before),"Importação inválida preserva a partida")
	var valid := FileAccess.open("/tmp/save-valido-migracao.json",FileAccess.WRITE)
	valid.store_string(raw);valid.close()
	g.import_save("/tmp/save-valido-migracao.json");await layout()
	check(g.values.get("entre-restaurante-12")==raw,"Importação válida usa validador nativo")
	check(g.persist({"probe":"backup"}),"Gravação atômica com backup")
	var corrupt := FileAccess.open(g.STORE,FileAccess.WRITE)
	corrupt.store_string("{broken");corrupt.close()
	check(g.read_values().get("entre-restaurante-12")==raw,"Recuperação do backup após corrupção do arquivo principal")
	print("FALHAS: ",failures)
	g.queue_free();await process_frame;quit(1 if failures else 0)
