config_version=5
[application]
config/name="Entre Esquinas — Restaurante"
config/version="0.21.2-godot.12"
run/main_scene="res://mundo/Restaurante.tscn"
run/max_fps=60
config/features=PackedStringArray("4.6", "GL Compatibility")
[display]
window/size/viewport_width=960
window/size/viewport_height=700
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
[input_devices]
pointing/emulate_mouse_from_touch=true
[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.13,0.22,0.17,1)
