config_version=5
[application]
config/name="Entre Esquinas — Redesenho 32px"
run/main_scene="res://Amostra.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
[display]
window/size/viewport_width=512
window/size/viewport_height=352
window/size/window_width_override=1024
window/size/window_height_override=704
window/stretch/mode="canvas_items"
[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.094, 0.12, 0.102, 1)
